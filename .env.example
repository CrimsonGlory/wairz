# Database
DATABASE_URL=postgresql+asyncpg://wairz:wairz@localhost:5432/wairz

# Redis (for task queue)
REDIS_URL=redis://localhost:6379/0

# Firmware storage location (relative paths resolved from backend/)
STORAGE_ROOT=./data/firmware

# Upload limits (applies to both backend and frontend nginx)
MAX_UPLOAD_SIZE_MB=500

# Tool output limits
MAX_TOOL_OUTPUT_KB=30
MAX_TOOL_ITERATIONS=25

# Ghidra headless path (inside container)
GHIDRA_PATH=/opt/ghidra
GHIDRA_SCRIPTS_PATH=/opt/ghidra_scripts
# Synchronous (MCP-blocking) Ghidra timeout. Bounded by the MCP transport
# timeout (~600s in most clients) — keep well under that.
GHIDRA_TIMEOUT=300
# Detached background-worker timeouts. Not bounded by MCP transport, so
# they can be much larger. Defaults: 1h full-binary analysis, 30m per
# function. Bump for very large MIPS/ARM daemons (~7MB+).
GHIDRA_BACKGROUND_ANALYSIS_TIMEOUT=3600
GHIDRA_BACKGROUND_DECOMPILE_TIMEOUT=1800

# Fuzzing (AFL++)
FUZZING_IMAGE=wairz-fuzzing
FUZZING_TIMEOUT_MINUTES=120
FUZZING_MAX_CAMPAIGNS=1
FUZZING_MEMORY_LIMIT_MB=2048
FUZZING_CPU_LIMIT=2.0
FUZZING_DATA_DIR=/data/fuzzing

# Docker socket GID inside the backend container. Must match the group
# that owns /var/run/docker.sock so the backend can manage emulation /
# fuzzing / carving containers.
#   Linux: run `getent group docker | cut -d: -f3` on the host
#   Docker Desktop for Mac: set to 0 — the socket appears as root:root
#     inside the container regardless of host ownership
DOCKER_GID=999

# UART Bridge (host-side serial bridge for live device access)
UART_BRIDGE_HOST=host.docker.internal
UART_BRIDGE_PORT=9999
UART_COMMAND_TIMEOUT=30

# Host interface the frontend (:3000) and backend (:8000) ports bind to.
# Default 127.0.0.1 keeps Wairz reachable only from the machine it runs on.
# To serve it to other machines on your LAN, set BIND_ADDR=0.0.0.0 (and make
# sure ALLOWED_HOSTS/GUARD_TRUST_PRIVATE_NETWORK below permit the client Host).
BIND_ADDR=127.0.0.1

# Network access guard (CSRF / DNS-rebinding protection on the API)
# ---------------------------------------------------------------------------
# The backend only answers requests whose Host/Origin it trusts. Out of the
# box it trusts localhost AND any private-network address (RFC1918 / loopback /
# link-local), so reaching Wairz on a LAN server by its IP just works.
#
# If you serve it under a DNS name or a public IP, add them here (the Host a
# browser sends INCLUDES the port). Comma-separated. Example:
#   ALLOWED_HOSTS=wairz.lan:3000,10.0.0.5:3000
#   ALLOWED_ORIGINS=http://wairz.lan:3000,http://10.0.0.5:3000
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
# Set to false on a public-facing single-host deploy to trust ONLY the explicit
# allowlist above (tightest posture). Behind an authenticating proxy, set
# ALLOWED_HOSTS=* / ALLOWED_ORIGINS=* to disable the checks instead.
GUARD_TRUST_PRIVATE_NETWORK=true

# Logging
LOG_LEVEL=INFO
