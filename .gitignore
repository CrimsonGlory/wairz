# Parallel-dispatch worktrees (CLAUDE.md Rule #23 Option A)
.worktrees/

# PostgreSQL backups (pg-backup service default target, see docs/operations/backup-recovery.md)
/backups/

# Operational state files (harness-mutated; closeout antipattern #4 closure 2026-05-10)
# These files are written by the Citadel harness during agent sessions and have
# no semantic value to commit. Tracking them creates noise in `git status` and
# breaks `git stash --include-untracked` checkpoint flows (cf. windows-coverage-godmode
# epsilon-1b postmortem antipattern #7).
.claude/circuit-breaker-state.json
.claude/consent-session-externalActions.json
.planning/daemon.json
.planning/telemetry/*.jsonl
.planning/fleet/session-*.md

# Phase λ.α.C: Vol3 ISF symbol bundles baked at build time
# (Rule #37). Bundles are large (~885 MiB combined) and pinned via the
# committed SHA256SUMS; they're downloaded by
# scripts/refresh-vol3-symbols.sh on the build host and NEVER committed
# to git. README.md + SHA256SUMS.url ARE tracked. SHA256SUMS itself will
# be tracked once the first refresh writes it.
backend/vol3-symbols/*.zip
backend/vol3-symbols/SHA256SUMS.tmp
backend/vol3-symbols/*.zip.tmp
